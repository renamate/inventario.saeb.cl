# Copia este archivo a .env.local (desarrollo) o carga las variables en Vercel.

# Clave de acceso compartida para los perfiles demo (voluntario, encargada, administrador).
# En producción usa una clave larga y no la publiques.
# Si se omite en desarrollo local, la clave por defecto es saeb2027.
DEMO_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# --- Neon (opcional) ---
# Connection string del proyecto Neon (consola → Connection Details → pooled o direct).
# Si falta, la app funciona en "modo demo local" con los datos de data/seed.json.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Fuerza el modo demo local aunque Neon esté configurado (valor: local).
# DATA_MODE=local

# URL pública para las etiquetas QR (por ejemplo https://inventario.saeb.cl).
# Si se omite, se usa el dominio desde el que se abre la app.
# APP_URL=
